  worlds:
  - name: Brasslight Quarter
    tagline: The rooftops and docks of the city where the Order began.
    color: {r: 0.4862745, g: 0.40784314, b: 0.8392157, a: 1}
  - name: Frost Citadel
    tagline: A fortress carved into the glacier. Frost Mites gnaw the halls and the moats are full of ice spikes.
    color: {r: 0.3372549, g: 0.6431373, b: 0.8627451, a: 1}
  - name: Sky Foundry
    tagline: Floating forges above the clouds. Ride steam springs and drifting plates past the Gearwatch Elite.
    color: {r: 0.8627451, g: 0.47058824, b: 0.23529412, a: 1}
  - name: Shadow Spire
    tagline: The Gearwatch's own tower. Elites on every floor, spikes below, and the Grandmaster at the top.
    color: {r: 0.47058824, g: 0.23529412, b: 0.6666667, a: 1}
